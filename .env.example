# AETHRYON — local development settings for compose.dev.yml.
# Copy to `.env` (git-ignored). Every value below is an EXAMPLE: nothing here works against a real service.
#
# Secrets are NEVER passed as environment variables: the services read them from FILES mounted read-only
# (`*_FILE` variables). `make dev-secrets` creates the random local ones in .dev/secrets/ (git-ignored).

# --- Ports (published on 127.0.0.1 only) ----------------------------------------------------------------------
DEV_WEB_PORT=18110          # site + account API (http://localhost:18110)
DEV_API_PORT=18111          # media API (fake worker by default)
DEV_INTERNAL_SUBNET=10.251.90.0/24   # private network between account and the media API

# --- Accounts ------------------------------------------------------------------------------------------------------
DEV_ADMIN_EMAILS=admin@example.test  # e-mails that get the admin role (Control Center)
ICLOUD_SHORTCUT_URL=                  # optional public iCloud link of YOUR signed Shortcut

# --- Optional integrations ------------------------------------------------------------------------------------------
# Each integration stays disabled until its secret file exists. Create the files yourself (mode 0400), e.g.:
#
#   Google sign-in   .dev/secrets/account/google_client_id        123456789-example.apps.googleusercontent.com
#                    .dev/secrets/account/google_client_secret    (your OAuth client secret)
#   Discord login    .dev/secrets/account/discord_client_secret   (+ DISCORD_CLIENT_ID in apps/account/.env.example)
#   Stripe (test)    .dev/secrets/account/stripe_secret_key       sk_test_... (TEST mode only in development)
#                    .dev/secrets/account/stripe_webhook_secret   whsec_...
#   SMTP (e-mail)    .dev/secrets/account/smtp_password           (password of your SMTP relay)
#   S3 / Backblaze   .dev/secrets/account/s3_access_key_id        (application key id)
#                    .dev/secrets/account/s3_secret_access_key    (application key)
#   Spotify import   .dev/secrets/media-api/spotify_client_id / spotify_client_secret / spotify_refresh_token
#
# The variable names each service expects are documented in apps/account/.env.example,
# apps/media-api/.env.example and apps/discord-bot/.env.example.

# --- Discord bot (optional profile: docker-compose --profile discord ...) -------------------------------------------
DISCORD_CLIENT_ID=000000000000000000        # your application id (public)
DISCORD_GUILD_ID=000000000000000000         # your test server id
DISCORD_SITE_URL=http://localhost:18110
DISCORD_MEDIA_API_URL=http://127.0.0.1:18111
# The bot token goes in .dev/secrets/discord-bot/discord_bot_token (never in this file).
