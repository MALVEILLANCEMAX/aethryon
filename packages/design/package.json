{
  "name": "@aethryon/egide",
  "private": true,
  "version": "1.0.0",
  "description": "Égide : socle commun de design et de thèmes d'AETHRYON (jetons, moteur de thèmes, CSS, icônes, chouette, composants sans framework).",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "sync": "node scripts/build.mjs --sync",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-concurrency=1 tests/*.test.ts",
    "test:navigateur": "node tests/navigateur/essais.mjs",
    "taille": "node scripts/taille.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  }
}
