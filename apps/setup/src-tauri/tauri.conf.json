{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AETHRYON Setup",
  "mainBinaryName": "aethryon-setup-ui",
  "version": "2.0.0-beta.9",
  "identifier": "fr.aethryon.setup",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:5174" },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Installation d'AETHRYON",
        "width": 960,
        "height": 640,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "visible": false,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0F0F10"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "publisher": "AETHRYON",
    "copyright": "© 2026 AETHRYON",
    "shortDescription": "AETHRYON Setup",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.png"]
  }
}
