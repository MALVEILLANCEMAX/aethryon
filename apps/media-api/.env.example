# ytapi configuration — copy to .env (chmod 600). Never commit .env.
# After editing .env: `docker-compose up -d` (a plain `restart` does NOT reload .env).

# --- Auth --------------------------------------------------------------------------------------
# Labelled tokens live in ./secrets/tokens (mode 600), managed with `make rotate-token LABEL=iphone`
# and reloaded without restart. API_TOKEN below is an optional extra token (label "env"); leave it
# empty once you use labelled tokens (`make disable-env-token`). At least one token must exist.
# Generate one with: openssl rand -hex 32   (min 24 characters)
API_TOKEN=

# --- Sources -------------------------------------------------------------------------------
# Allowed domains: exact host or any subdomain of these (www., m., music., vm., vt., mobile.).
# Comma-separated. To disable a platform, remove ALL its domains
# (youtube.com, youtu.be, youtube-nocookie.com / tiktok.com / twitter.com, x.com).
ALLOWED_DOMAINS=youtube.com,youtu.be,youtube-nocookie.com,tiktok.com,twitter.com,x.com

# --- Limits --------------------------------------------------------------------------------
# Parallel downloads/conversions (each runs yt-dlp + ffmpeg in its own process).
# /info runs in a separate pool of 2 x MAX_CONCURRENT processes (at least 2).
MAX_CONCURRENT=2
# Extra downloads allowed to wait for a slot (sync /dl + jobs); beyond that: 503 server_busy.
MAX_QUEUE=10
# Longest media accepted, in seconds (413 too_long above).
MAX_DURATION_S=3600
# Largest file accepted, in MiB (413 too_large above; checked before and during download).
# A download is also refused (503 insufficient_storage) when free disk space minus what the
# already admitted downloads may still write is below 2 x MAX_FILESIZE_MB + 512 MiB.
MAX_FILESIZE_MB=1500
# Hard timeout for one download + conversion, in seconds (504 timeout above). Time spent queued
# (status "queued") is not counted.
DOWNLOAD_TIMEOUT_S=1800
# Timeout for /info, in seconds.
INFO_TIMEOUT_S=90
# transcode=true (VP9/AV1 -> H.264, slow) is refused above this media duration, in seconds.
TRANSCODE_MAX_DURATION_S=900
# fmt=gif is refused above this media duration, in seconds.
GIF_MAX_DURATION_S=30
# Finished jobs and their files are deleted this many minutes after the job ends.
JOB_TTL_MIN=60
# Per client IP, for /dl, /info and POST /jobs ("N/second|minute|hour", e.g. 20/minute).
# /status, polling, file and delete get max(120, 10 x N) requests per minute, whatever the
# period. Traefik also limits each IP to 60 requests/min (burst 30) on /media.
RATE_LIMIT=20/minute

# --- Result cache --------------------------------------------------------------------------
# Same media + same output parameters within CACHE_TTL_MIN minutes: the file is served again
# without downloading (0 disables). MAX_CACHE_MB caps the cache; the oldest entries go first.
CACHE_TTL_MIN=30
MAX_CACHE_MB=2000

# --- YouTube protection --------------------------------------------------------------------
# After a bot check or a rate limit, YouTube is not contacted for YT_COOLDOWN_MIN minutes
# (immediate 503 + Retry-After instead). 0 disables the circuit breaker.
YT_COOLDOWN_MIN=15
# Consecutive blocks (no success in between) double the pause, up to YT_COOLDOWN_MAX_MIN minutes.
YT_COOLDOWN_MAX_MIN=60
# YouTube extractions at the same time, and minimum seconds between two extraction starts.
YT_CONCURRENCY=1
YT_MIN_INTERVAL_S=3
# Optional proxy used ONLY for YouTube (e.g. socks5h://100.x.y.z:1080 through NetBird to a home
# PC, see README). Empty = direct. Its credentials are masked in logs (host:port may appear).
YT_PROXY=

# --- yt-dlp ----------------------------------------------------------------------------------
# Cookies: install them with `make cookies-install FILE=...` (fixed path /run/secrets/cookies.txt,
# picked up without restart; state in /status). Nothing to set here.
# Extra yt-dlp extractor args, same syntax as --extractor-args, several separated by '|'.
# PO token provider (optional, see README): WITH_POT=1, COMPOSE_PROFILES=pot and
# YTDLP_EXTRACTOR_ARGS=youtubepot-bgutilhttp:base_url=http://bgutil-pot:4416, then `make update`.
YTDLP_EXTRACTOR_ARGS=
WITH_POT=0

# --- Extraits (startMs/endMs ; MEDIA_TOOLS_ENABLED=true, fixé dans docker-compose.yml) -----------
# Seule la plage demandée est récupérée (jamais la vidéo entière) ; la durée de la source ne compte pas.
# Longueur maximale d'un extrait en secondes (un GIF est aussi limité par GIF_MAX_DURATION_S).
EXTRAIT_DUREE_MAX_S=600
# Taille maximale du fichier produit, en Mio.
EXTRAIT_SORTIE_MAX_MB=1024
# Octets reçus de la plateforme au plus pour un extrait, en Mio (au-delà : arrêt, extrait_partiel_impossible).
EXTRAIT_TELECHARGEMENT_MAX_MB=1024
# Durée maximale du traitement d'un extrait, en secondes.
EXTRAIT_TRAITEMENT_MAX_S=1800
# Extraits traités en même temps (chacun réencode : 1 sur 3 vCPU).
EXTRAIT_SIMULTANES_MAX=1

# --- Misc ----------------------------------------------------------------------------------
# DEBUG, INFO, WARNING or ERROR. Logs are JSON on stderr, tokens are never logged (label only).
# DEBUG also turns on yt-dlp's verbose output.
LOG_LEVEL=INFO
# true = enable /docs, /redoc and /openapi.json WITHOUT token (API schema only, no data).
# Keep false in production.
DEBUG=false

# Fixed in docker-compose.yml `environment:` (values set in this file are IGNORED); change them
# there, together with the Traefik labels:
#   ROOT_PATH=/media  TMP_DIR=/data/tmp  CACHE_DIR=/data/cache  FORWARDED_ALLOW_IPS=172.18.0.0/16
#   COOKIES_FILE=/run/secrets/cookies.txt  TOKENS_FILE=/run/secrets/tokens
