# media-api — conversion service (FastAPI + yt-dlp + ffmpeg). EXAMPLE values only.
# Copy to .env (mode 600, git-ignored). Secrets live in FILES (TOKENS_FILE, *_FILE), never in this file.
#
# Responsible use: run this service only for media you own or are allowed to download and convert, and respect the
# terms of the platforms you use it with. See docs/legal/responsible-use.md.

# --- Authentication ---------------------------------------------------------------------------------------------------
# Labelled admin tokens, one "label token" per line (mode 600), managed with scripts/rotate_token.py.
TOKENS_FILE=/run/secrets/tokens
# Personal user keys (ytc_…) are checked against the account service over the private network.
USER_KEYS_ENABLED=true
ACCOUNT_INTERNAL_URL=http://account-internal:3001
ACCOUNT_INTERNAL_TOKEN_FILE=/run/secrets/account_internal_token
INTERNAL_ALLOW_FROM=10.251.90.0/24
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Sources ----------------------------------------------------------------------------------------------------------
# Allowed domains (exact host or subdomain). Remove a platform's domains to disable it.
ALLOWED_DOMAINS=youtube.com,youtu.be,youtube-nocookie.com,tiktok.com,twitter.com,x.com

# --- Limits -----------------------------------------------------------------------------------------------------------
MAX_CONCURRENT=2            # parallel downloads/conversions
MAX_QUEUE=10                # extra jobs allowed to wait (503 server_busy beyond)
MAX_DURATION_S=3600         # longest media accepted (413 too_long)
MAX_FILESIZE_MB=1500        # largest file accepted (413 too_large); free disk is also checked
DOWNLOAD_TIMEOUT_S=1800
INFO_TIMEOUT_S=90
TRANSCODE_MAX_DURATION_S=900
GIF_MAX_DURATION_S=30
JOB_TTL_MIN=60              # finished jobs and files are deleted after this many minutes
RATE_LIMIT=20/minute        # per client IP for /dl, /info and POST /jobs

# --- Result cache -------------------------------------------------------------------------------------------------------
CACHE_TTL_MIN=30
MAX_CACHE_MB=2000

# --- Politeness towards platforms ------------------------------------------------------------------------------------------
# After a refusal or a rate limit from a platform, the service pauses requests to it (circuit breaker) instead of
# retrying aggressively.
YT_COOLDOWN_MIN=15
YT_COOLDOWN_MAX_MIN=60
YT_CONCURRENCY=1
YT_MIN_INTERVAL_S=3
YT_PROXY=                   # optional outbound proxy (socks5h://host:port); empty = direct
YTDLP_EXTRACTOR_ARGS=       # optional yt-dlp extractor arguments (same syntax as --extractor-args)

# --- Clips (startMs/endMs) -------------------------------------------------------------------------------------------------
EXTRAIT_DUREE_MAX_S=600
EXTRAIT_SORTIE_MAX_MB=1024
EXTRAIT_TELECHARGEMENT_MAX_MB=1024
EXTRAIT_TRAITEMENT_MAX_S=1800
EXTRAIT_SIMULTANES_MAX=1

# --- Optional modules (closed by default) ------------------------------------------------------------------------------------
MEDIA_TOOLS_ENABLED=false
TOOLS_ENABLED=false
MUSIC_ENABLED=false
# Spotify playlist import (optional): files with YOUR app credentials.
MUSIC_SPOTIFY_CLIENT_ID_FILE=/run/secrets/spotify_client_id
MUSIC_SPOTIFY_CLIENT_SECRET_FILE=/run/secrets/spotify_client_secret
MUSIC_SPOTIFY_REFRESH_TOKEN_FILE=/run/secrets/spotify_refresh_token

# --- Logs ------------------------------------------------------------------------------------------------------------------------
LOG_LEVEL=INFO
DEBUG=false
