# discord-bot — AETHRYON Discord bot (discord.js 14). EXAMPLE values only: create YOUR OWN Discord application.
# The bot token is NEVER an environment variable: it is read from a file (DISCORD_BOT_TOKEN_FILE).

# --- Discord application (public identifiers, not secrets) --------------------------------------------------------------
DISCORD_CLIENT_ID=000000000000000000        # Developer Portal › your application › Application ID
DISCORD_GUILD_ID=000000000000000000         # your test server (guild commands appear instantly there)
DISCORD_BOT_TOKEN_FILE=/run/secrets/discord_bot_token   # file content: the bot token (Developer Portal › Bot)

# --- AETHRYON endpoints ---------------------------------------------------------------------------------------------------
AETHRYON_SITE_URL=https://example.com                    # your AETHRYON site (links in replies)
YTAPI_URL=https://example.com/media                      # your media API
AETHRYON_API_HEALTH_URL=https://example.com/media/health
AETHRYON_TERMS_PUBLISHED=0                               # 1 = /help links to the published terms page
AETHRYON_EMOJI=                                          # optional application emoji, e.g. <:aethryon:123456789012345678>
DISCORD_ACTIVITY=                                        # optional presence text (empty = none)

# --- Account linking and conversions (closed by default) ---------------------------------------------------------------
# Each feature requires the ones listed in brackets; the bot refuses to start with an inconsistent set.
LINK_ENABLED=0               # /account (link a Discord user to an AETHRYON account)
CONVERT_ENABLED=0            # /convert, /audio, message menu   [LINK_ENABLED]
FILES_ENABLED=0              # deliver files as attachments      [CONVERT_ENABLED]
COMPRESS_ENABLED=0           # compress to Discord's size limit  [FILES_ENABLED]
PREVIEW_ENABLED=0            # /preview                          [CONVERT_ENABLED]
CLIP_ENABLED=0               # /clip                             [CONVERT_ENABLED]
GIF_ENABLED=0                # /gif                              [CONVERT_ENABLED]
TOOLS_ENABLED=0              # AETHRYON Tools buttons            [CONVERT_ENABLED]
LIBRARY_ENABLED=0            # /saved                            [LINK_ENABLED]
GUILD_CONFIG_ENABLED=0       # /config (server settings)         [LINK_ENABLED]
AUTO_EMBEDS_ENABLED=0        # automatic cards for posted links  [GUILD_CONFIG_ENABLED, CONVERT_ENABLED]
ACCOUNT_INTERNAL_URL=http://account-internal:3002        # account's bot API (private network only)
DISCORD_INTERNAL_TOKEN_FILE=/run/secrets/discord_internal_token   # shared secret with account (X-Bot-Token)

# --- Command registration ---------------------------------------------------------------------------------------------------
# npm run register              -> guild commands on DISCORD_GUILD_ID
# DISCORD_GLOBAL_OK=1 node dist/register.js --global   -> global commands (server AND user installs)
DISCORD_GLOBAL_OK=0
HEARTBEAT_FILE=/tmp/aethryon-discord-heartbeat
