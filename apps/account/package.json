{
  "name": "ytc2-account",
  "private": true,
  "version": "2.0.0",
  "description": "YouTube Converter 2.0 — comptes Google, jetons API personnels, quotas",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@better-auth/api-key": "1.7.7",
    "@hono/node-server": "2.1.4",
    "better-auth": "1.7.7",
    "hono": "4.13.13",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
