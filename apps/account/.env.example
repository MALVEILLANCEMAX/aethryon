# account — accounts, sessions, personal API keys, quotas, billing (Node 22, Hono, Better Auth, SQLite).
# EXAMPLE values only. Secrets are read from FILES (`*_FILE`), never from plain variables.
# In development these variables are set by compose.dev.yml; add the optional ones with a
# docker-compose.override.yml (git-ignored is recommended) — see docs/installation/development.md.

# --- Required ---------------------------------------------------------------------------------------------------------
PUBLIC_URL=http://localhost:18110                       # public origin of the site (cookies, CSRF origin check)
BETTER_AUTH_SECRET_FILE=/run/secrets/better_auth_secret # random string, 32+ characters
INTERNAL_TOKEN_FILE=/run/secrets/account_internal_token # shared with the media API (X-Internal-Token)
DB_PATH=/data/account.sqlite                            # SQLite database (WAL). NEVER commit or publish it.
BACKUP_DIR=/data/backups
YTAPI_INTERNAL_URL=http://media-api-internal:8000       # media API, private network only
API_PUBLIC_URL=http://127.0.0.1:18111                   # media API as seen by clients (Shortcut, extension)
INTERNAL_ALLOW_FROM=10.251.90.0/24                      # who may call the internal API (port 3001)
TRUST_PROXY_IP_HEADER=x-real-ip

# --- Product settings ---------------------------------------------------------------------------------------------------
DAILY_CONVERSIONS=10
MAX_ACTIVE_JOBS=1
MAX_KEYS_PER_USER=2
MAX_USERS=50
ADMIN_EMAILS=admin@example.test
USER_KEYS_ACTIVE=1
SHORTCUT_VERSION=3.0
FALLBACK_DOWNLOAD=/downloads/AETHRYON.shortcut
ICLOUD_SHORTCUT_URL=                                    # https://www.icloud.com/shortcuts/<32 hex> or empty
EXTENSION_IDS=dnllfjakdgmgfiompaheickmbjjlgjdc          # allowed browser-extension ids (dev build id shown)

# --- Google sign-in (optional: disabled while the files are missing) ----------------------------------------------------
GOOGLE_CLIENT_ID_FILE=/run/secrets/google_client_id          # file content: 123456789-example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET_FILE=/run/secrets/google_client_secret  # file content: your OAuth client secret

# --- Discord login and account linking (optional) -------------------------------------------------------------------------
DISCORD_CLIENT_ID=000000000000000000
DISCORD_CLIENT_SECRET_FILE=/run/secrets/discord_client_secret
DISCORD_LOGIN=0
DISCORD_INTERNAL_TOKEN_FILE=/run/secrets/discord_internal_token   # shared with the bot (port 3002)
DISCORD_INTERNAL_ALLOW_FROM=10.251.92.0/24

# --- E-mail sign-up and notifications (optional: needs SMTP_USER + the password file) ------------------------------------
SMTP_HOST=smtp.example.com
SMTP_USER=example-user
SMTP_PASSWORD_FILE=/run/secrets/smtp_password
MAIL_FROM=AETHRYON <noreply@example.com>

# --- Billing with Stripe (optional; off by default) ---------------------------------------------------------------------
# BILLING=off | test | live. In development ALWAYS use test mode: the key file must contain sk_test_... or rk_test_...
BILLING=off
STRIPE_SECRET_KEY_FILE=/run/secrets/stripe_secret_key
STRIPE_WEBHOOK_SECRET_FILE=/run/secrets/stripe_webhook_secret       # whsec_...
STRIPE_PORTAL_CONFIGURATION=
BILLING_SALES=fermees
BILLING_TERMS_URL=
BILLING_VAT_MENTION=

# --- AETHRYON Cloud: private S3 bucket, e.g. Backblaze B2 (optional; off by default) ------------------------------------
CLOUD=off
CLOUD_S3_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
CLOUD_S3_REGION=eu-central-003
CLOUD_S3_BUCKET=example-bucket
CLOUD_S3_PREFIX=aethryon-cloud/
CLOUD_S3_ACCESS_KEY_ID_FILE=/run/secrets/s3_access_key_id
CLOUD_S3_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_access_key

# --- Feature switches (closed by default) ---------------------------------------------------------------------------------
TOOLS_ENABLED=0
PREMIERE_CONNEXION=0
DESKTOP_CONNEXION=0
MUSIC_RELAY=0
LOG_LEVEL=info
